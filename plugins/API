const axios = require('axios');

module.exports = {
    name: 'تنزيل',
    alias: ['video', 'تحميل', 'فيديو'],
    category: 'download',
    desc: 'تحميل فيديوهات باستخدام API خارجي',
    async execute(Client, message, args) {
        if (!args[0]) return message.reply('❌ يرجى إدخال رابط الفيديو المُراد تحميله!');

        const videoUrl = args[0];
        // استبدل الرابط أدناه برابط موقع الـ API ومفتاحك الخاص (ApiKey)
        const apiUrl = `https://yourwebsite.com{encodeURIComponent(videoUrl)}&apikey=YOUR_KEY`;

        try {
            await message.reply('⏳ جاري معالجة وتحميل الفيديو، يرجى الانتظار...');
            
            // جلب البيانات من الـ API
            const response = await axios.get(apiUrl);
            const videoData = response.data;

            if (videoData.status && videoData.result.url) {
                // إرسال الفيديو المستخرج إلى المحادثة
                await Client.sendMessage(message.from, { 
                    video: { url: videoData.result.url }, 
                    caption: '✅ تم التحميل بنجاح بواسطة بوت كاكاشي' 
                }, { quoted: message });
            } else {
                message.reply('❌ فشل الجلب، تأكد من صحة الرابط أو صلاحية الـ API.');
            }
        } catch (error) {
            console.error(error);
            message.reply('❌ حدث خطأ أثناء الاتصال بالخادم الرئيسي.');
        }
    }
};
